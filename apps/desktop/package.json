{
  "name": "@astragit/desktop",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "description": "独立 Git 工作台与 AI 提交说明",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit"
  },
  "dependencies": {
    "@astragit/git-server": "workspace:*",
    "@astragit/ai-runtime": "workspace:*",
    "@astragit/git-core": "workspace:*",
    "@astragit/shared": "workspace:*",
    "@astragit/storage": "workspace:*"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/node": "^24.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "42.4.0",
    "typescript": "5.9.3",
    "vite": "^8.0.16"
  }
}
